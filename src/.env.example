# Local secrets template — copy to .env and fill in your own keys
# .env is gitignored; this template is committed.
#
# Usage: `cp .env.example .env && $EDITOR .env`
# Scripts will refuse to start if these are not set.

# === OpenAI (required for memory embeddings via text-embedding-3-small) ===
OPENAI_API_KEY=            # text-embedding-3-small (memory retrieval)
# LLM judge for score_locomo_qa_dumps.py --llm_judge
# LLM_JUDGE_PROVIDER=azure: own key + Azure v1 endpoint; openai: reuse OPENAI_API_KEY above
# LLM_JUDGE_PROVIDER=azure   (default; set per run instead so `sbatch --export` can override)
LLM_JUDGE_API_KEY=
LLM_JUDGE_BASE_URL=        # https://<resource>.openai.azure.com/openai/v1/
LLM_JUDGE_MODEL=           # Azure deployment name (openai provider: default gpt-4o-mini)

# === HuggingFace (required for downloading Qwen2.5 / Llama models) ===
HF_TOKEN=

# === Gemini / Together (judge fallback if not using local gpt-oss-120b) ===
GEMINI_API_KEY=
TOGETHER_API_KEY=

# === Mem0 / Zep (only for OOD baselines) ===
MEM0_API_KEY=
MEM0_PROJECT_ID=
MEM0_ORGANIZATION_ID=
ZEP_API_KEY=

# === WandB ===
WANDB_API_KEY=

# === Defaults ===
MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
JUDGE_PROVIDER=together
